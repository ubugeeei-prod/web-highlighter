///|
test "verified cursor and scanner helpers accept only bounded shapes" {
  assert_eq(@cursor_proof.advance_utf16_index(5, 0, 1), 1)
  assert_eq(@cursor_proof.advance_utf16_index(5, 1, 2), 3)
  assert_eq(@scanner_proof.walk_to_limit(10, 3, 7), 7)
  assert_eq(@scanner_proof.prefix_end(2, 3, 10), 5)
  assert_eq(@scanner_proof.token_span_width(2, 6, 8), 4)
  assert_eq(@scanner_proof.cursor_after_ordered_pair(0, 2, 4, 7, 8), 7)
  assert_eq(@scanner_proof.add_line_count(3, 4), 7)
  assert_eq(@scanner_proof.next_budget_count(0, 2), 1)
  assert_eq(@scanner_proof.next_budget_count(2, 2), 2)
  assert_true(@scanner_proof.span_is_bounded(0, 0, 0))
  assert_true(@scanner_proof.span_is_nonempty(0, 1, 1))
  assert_true(!@scanner_proof.span_is_nonempty(1, 1, 1))
  assert_true(!@scanner_proof.span_is_nonempty(-1, 1, 1))
  assert_true(!@scanner_proof.span_is_nonempty(0, 2, 1))
  assert_true(@scanner_proof.span_is_ordered_after(2, 3, 5, 8))
  assert_true(!@scanner_proof.span_is_ordered_after(4, 3, 5, 8))
  assert_true(@scanner_proof.region_cursor_is_bounded(2, 8, 8))
  assert_true(!@scanner_proof.region_cursor_is_bounded(3, 2, 8))
  assert_true(@scanner_proof.count_is_nonnegative(0))
  assert_true(@scanner_proof.count_is_nonnegative(4))
  assert_true(!@scanner_proof.count_is_nonnegative(-1))
  assert_true(@model_proof.source_length_is_allowed(2, 2))
  assert_true(!@model_proof.source_length_is_allowed(3, 2))
  assert_true(!@model_proof.source_length_is_allowed(0, -1))
  assert_true(@scanner_proof.item_budget_allows(0, 1))
  assert_true(!@scanner_proof.item_budget_allows(1, 1))
  assert_true(!@scanner_proof.item_budget_allows(-1, 1))
  assert_true(@detection_proof.score_is_dominant(6, 2, 3, 2))
  assert_true(!@detection_proof.score_is_dominant(2, 0, 3, 2))
  assert_true(!@detection_proof.score_is_dominant(4, 3, 3, 2))
  assert_true(!@theme_proof.theme_needs_surface_fallback_flag(1, 1))
  assert_true(@theme_proof.theme_needs_surface_fallback_flag(0, 1))
  assert_eq(@theme_proof.resolved_surface_dark_flag(0, 1), 1)
  assert_eq(@theme_proof.resolved_surface_dark_flag(1, 0), 0)
}

///|
test "verified sweep helpers accept only covering slices" {
  assert_true(@sweep_proof.span_covers_segment(2, 6, 4, 8))
  assert_true(@sweep_proof.span_covers_segment(0, 12, 4, 8))
  assert_true(!@sweep_proof.span_covers_segment(2, 4, 4, 8))
  assert_true(!@sweep_proof.span_covers_segment(8, 9, 4, 8))
  assert_true(@sweep_proof.span_covers_segment(0, 12, 4, 4))
  assert_true(@sweep_proof.span_precedes_segment(4, 4))
  assert_true(!@sweep_proof.span_precedes_segment(5, 4))
  assert_true(@sweep_proof.span_follows_segment(8, 8))
  assert_true(!@sweep_proof.span_follows_segment(7, 8))
  assert_eq(@sweep_proof.clip_span_start(2, 4), 4)
  assert_eq(@sweep_proof.clip_span_start(6, 4), 6)
  assert_eq(@sweep_proof.clip_span_end(9, 8), 8)
  assert_eq(@sweep_proof.clip_span_end(7, 8), 7)
}
