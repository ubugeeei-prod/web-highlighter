///|
/// Languages picked from the 2026-07 hosted-service gap survey.
///
/// Each one was recurring in shared code yet missing from the default bundles
/// the surveyed services ship. See `docs/research.md`.
fn curated_languages() -> Array[Language] {
  [
    make_language(
      id="mojo",
      name="Mojo",
      aliases=["🔥"],
      extensions=["mojo", "🔥"],
      filenames=[],
      signatures=[
        signature("fn main() raises:", 3),
        signature("@value", 2),
        signature("var ", 1),
        signature("SIMD[", 2),
      ],
      keywords="alias as async await break case comptime const continue def elif else fn for from if import in let match owned raises return struct trait try var while with",
      types="Bool DTypePointer DynamicVector Error Float16 Float32 Float64 Int Int8 Int16 Int32 Int64 List SIMD String StringLiteral UInt Unit",
      constants="True False None",
      declarations=[
        ("alias", TypeSymbol),
        ("def", FunctionSymbol),
        ("fn", FunctionSymbol),
        ("let", VariableSymbol),
        ("struct", TypeSymbol),
        ("trait", TypeSymbol),
        ("var", VariableSymbol),
      ],
      line_comments=["#"],
      block_comments=[],
      strings=[quoted("\"\"\""), quoted("\""), quoted("'")],
      operator_chars="+-*/%=<>!&|^~?.@",
      identifier_extra="$",
    ),
    make_language(
      id="gleam",
