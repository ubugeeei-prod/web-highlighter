///|
/// Built-in languages from the 2026-09 survey, ordered by how widely known they are.
///
/// Every entry is missing from at least one of GitHub, GitLab, Discord, Zenn,
/// and Qiita, and the order is the notability ranking recorded in
/// `docs/research.md`.
fn builtin_notable_languages() -> Array[Language] {
  [
    make_language(
      id="zig",
      name="Zig",
      aliases=[],
      extensions=["zig", "zon"],
      filenames=["build.zig", "build.zig.zon"],
      signatures=[
        signature("@import(\"std\")", 3),
        signature("comptime ", 2),
        signature("errdefer ", 2),
        signature("orelse ", 1),
      ],
      keywords="addrspace align allowzero and anyframe anytype asm break callconv catch comptime const continue defer else enum errdefer error export extern fn for if inline linksection noalias noinline nosuspend opaque or orelse packed pub resume return struct suspend switch test threadlocal try union unreachable var volatile while",
      types="anyerror anyopaque bool c_char c_int c_long c_longdouble c_longlong c_short c_uint c_ulong c_ulonglong c_ushort comptime_float comptime_int f16 f32 f64 f80 f128 i8 i16 i32 i64 i128 isize noreturn type u8 u16 u32 u64 u128 usize void",
      constants="true false null undefined",
      declarations=[
        ("fn", FunctionSymbol),
        ("const", VariableSymbol),
        ("var", VariableSymbol),
      ],
      line_comments=["///", "//"],
      block_comments=[],
      strings=[quoted("\""), quoted("'")],
      operator_chars="+-*/%=<>!&|^~?.:",
      identifier_extra="@",
      functions="@This @TypeOf @alignOf @as @bitCast @call @cImport @compileError @embedFile @enumFromInt @errorName @field @hasDecl @import @intCast @intFromEnum @memcpy @panic @ptrCast @sizeOf @typeInfo",
    ),
    make_language(
      id="vlang",
      name="V",
      aliases=[],
      extensions=["vsh", "vv"],
      filenames=["v.mod"],
      signatures=[
        signature("module main", 3),
        signature("fn main()", 2),
        signature("mut ", 1),
        signature("pub fn ", 1),
      ],
      keywords="as asm assert atomic break const continue defer dump else enum fn for go goto if ilike implements import in interface is like likely lock match module mut offsetof or orelse pub return rlock select shared sizeof spawn static struct type typeof union unlikely unsafe volatile __global __offsetof",
      types="any array bool byteptr chan charptr f32 f64 i8 i16 i64 int isize map rune string thread u8 u16 u32 u64 usize voidptr",
      constants="true false none nil",
      declarations=[
        ("fn", FunctionSymbol),
        ("struct", TypeSymbol),
        ("enum", TypeSymbol),
        ("interface", TypeSymbol),
        ("type", TypeSymbol),
        ("const", VariableSymbol),
        ("module", ModuleSymbol),
      ],
      line_comments=["//"],
      block_comments=c_blocks(),
      strings=[quoted("\""), quoted("'"), quoted("`")],
      operator_chars="+-*/%=<>!&|^~?.:$#@",
      identifier_extra="",
    ),
    make_language(
      id="just",
      name="Just",
      aliases=["justfile"],
      extensions=["just"],
      filenames=["justfile", "Justfile", "JUSTFILE", ".justfile"],
      signatures=[
        signature("set shell :=", 3),
        signature("#!/usr/bin/env just", 3),
        signature("just --list", 2),
        signature(":= \"", 1),
      ],
      keywords="alias assert else export if import mod set unexport",
      types="",
      constants="true false",
      declarations=[
        ("alias", VariableSymbol),
        ("export", VariableSymbol),
        ("mod", ModuleSymbol),
      ],
      line_comments=["#"],
      block_comments=[],
      strings=[quoted("\"\"\""), quoted("'''"), quoted("\""), quoted("'")],
      operator_chars="+*/=<>!&|:@$",
      identifier_extra="-",
      functions="absolute_path arch canonicalize clean env env_var env_var_or_default error extension file_name file_stem invocation_directory join justfile justfile_directory lowercase num_cpus os os_family parent_directory path_exists quote replace semver_matches sha256 shell trim uppercase uuid without_extension",
      properties="allow-duplicate-recipes allow-duplicate-variables default-list dotenv-command dotenv-filename dotenv-load dotenv-override dotenv-path dotenv-required fallback ignore-comments positional-arguments quiet script-interpreter tempdir unstable windows-powershell windows-shell working-directory",
    ),
    make_language(
      id="carbon",
      name="Carbon",
      aliases=[],
      extensions=["carbon"],
      filenames=[],
      signatures=[
        signature("fn Main() -> i32", 3),
        signature("api;", 2),
        signature("Core.Print", 2),
        signature("impls ", 1),
      ],
      keywords="abstract adapt alias and api array as auto base bool break case char choice class const constraint continue Core Cpp default else eval export extend extern final fn for forall form friend generic if impl impls import in inline interface let library like match match_first musteval namespace not observe or override package partial private protected ref require return returned runtime Self self static str template then type unsafe unused val var virtual where while",
      types="f16 f32 f64 f128 i8 i16 i32 i64 i128 u8 u16 u32 u64 u128",
      constants="true false",
      declarations=[
        ("fn", FunctionSymbol),
        ("class", TypeSymbol),
        ("interface", TypeSymbol),
        ("choice", TypeSymbol),
        ("constraint", TypeSymbol),
        ("let", VariableSymbol),
        ("var", VariableSymbol),
        ("alias", VariableSymbol),
        ("namespace", ModuleSymbol),
        ("package", ModuleSymbol),
        ("library", ModuleSymbol),
      ],
      line_comments=["//"],
      block_comments=[],
      strings=[quoted("\"\"\""), quoted("\"")],
      operator_chars="+-*/%=<>!&|^~?.:@",
      identifier_extra="",
    ),
    make_language(
      id="slint",
      name="Slint",
      aliases=[],
      extensions=["slint"],
      filenames=[],
      signatures=[
        signature("inherits ", 3),
        signature("in property <", 3),
        signature("@image-url", 2),
        signature("callback ", 1),
      ],
      keywords="animate as callback changed component else enum export for from function global if import in in-out inherits init out private property public pure return states struct transitions",
      types="angle bool brush color duration easing float image int length percent physical-length relative-font-size string",
      constants="true false root parent self",
      declarations=[
        ("component", TypeSymbol),
        ("struct", TypeSymbol),
        ("enum", TypeSymbol),
        ("global", ModuleSymbol),
        ("callback", FunctionSymbol),
        ("function", FunctionSymbol),
      ],
      line_comments=["//"],
      block_comments=c_blocks(),
      strings=[quoted("\"")],
      operator_chars="+*/%=<>!&|?.:;",
      identifier_extra="-",
      properties="delay direction iteration-count",
    ),
    make_language(
      id="odin",
      name="Odin",
      aliases=[],
      extensions=["odin"],
      filenames=[],
      signatures=[
        signature("package main", 3),
        signature(":: proc(", 3),
        signature("or_return", 2),
        signature("fmt.println", 2),
      ],
      keywords="asm auto_cast bit_field bit_set break case cast context continue defer distinct do dynamic else enum fallthrough for foreign if import in map matrix not_in or_break or_continue or_else or_return package proc return struct switch transmute typeid union using when where",
      types="any b8 b16 b32 b64 bool byte complex32 complex64 complex128 cstring f16 f32 f64 i8 i16 i32 i64 i128 int quaternion64 quaternion128 quaternion256 rawptr rune string u8 u16 u32 u64 u128 uint uintptr",
      constants="true false nil",
      declarations=[("package", ModuleSymbol)],
      line_comments=["//"],
      block_comments=c_blocks(),
      strings=[quoted("\""), quoted("'"), quoted("`")],
      operator_chars="+-*/%=<>!&|^~?.:@$",
      identifier_extra="",
    ),
    make_language(
      id="purescript",
      name="PureScript",
      aliases=["purs"],
      extensions=["purs"],
      filenames=[],
      signatures=[
        signature("module Main where", 3),
        signature(":: Effect Unit", 3),
        signature("derive instance", 2),
        signature("<-", 1),
      ],
      keywords="ado as case class data derive do else forall foreign hiding if import in infix infixl infixr instance let module newtype of then type where",
      types="Aff Array Boolean Char Effect Either Int List Map Maybe Number Ordering Record Set String Tuple Unit",
      constants="true false Nothing Just Left Right unit LT EQ GT",
      declarations=[
        ("data", TypeSymbol),
        ("newtype", TypeSymbol),
        ("type", TypeSymbol),
        ("class", TypeSymbol),
        ("module", ModuleSymbol),
      ],
      line_comments=["--"],
      block_comments=[delimiter("{-", "-}")],
      strings=[quoted("\"\"\""), quoted("\"")],
      operator_chars="+-*/%=<>!&|^~?.:$#@\\",
      identifier_extra="",
    ),
    make_language(
      id="rescript",
      name="ReScript",
      aliases=["res"],
      extensions=["res", "resi"],
      filenames=[],
      signatures=[
        signature("@react.component", 3),
        signature("->Belt", 2),
        signature("Js.log", 2),
        signature("let make = ", 2),
      ],
      keywords="and as assert async await constraint downto else exception external for if in include lazy let module mutable of open rec switch to try type when while with",
      types="array bool char dict float int list option promise result string unit",
      constants="true false None Some Ok Error",
      declarations=[
        ("let", VariableSymbol),
        ("type", TypeSymbol),
        ("module", ModuleSymbol),
        ("external", FunctionSymbol),
        ("exception", TypeSymbol),
      ],
      line_comments=["//"],
      block_comments=c_blocks(),
      strings=[quoted("\""), quoted("`")],
      operator_chars="+-*/%=<>!&|^~?.:@#",
      identifier_extra="",
    ),
  ]
}
