///|
/// Languages this deployment was asked to support.
///
/// They are private, experimental, or composite formats whose adoption by any
/// upstream service is unlikely, so the extension is their only realistic
/// highlighting path.
fn requested_languages() -> Array[Language] {
  [
    make_language(
      id="idris",
      name="Idris 2",
      aliases=["idris2", "idr"],
      extensions=["idr", "lidr", "ipkg"],
      filenames=[],
      signatures=[
        signature("%default total", 3),
        signature("DecEq", 2),
        signature("data ", 1),
        signature(" where", 1),
      ],
      keywords="case class data do else export if implementation import in infix interface let module mutual namespace of parameters public record then total using where with",
      types="Bool Char Dec Double Either Fin IO Int Integer List Maybe Nat String Type Unit Vect",
      constants="True False Nothing Just Yes No",
      declarations=[
        ("data", TypeSymbol),
        ("interface", TypeSymbol),
        ("namespace", ModuleSymbol),
        ("record", TypeSymbol),
      ],
      line_comments=["--"],
      block_comments=[delimiter("{-", "-}")],
      strings=c_strings(),
      operator_chars="+-*/=<>!&|^~?.:$%\\",
      identifier_extra="$",
    ),
    make_language(
      id="moonbit",
      name="MoonBit",
      aliases=["mbt", "mbtx", "mbti", "mbtp", "moonbit-executable"],
      extensions=["mbt", "mbtx", "mbti", "mbtp"],
      filenames=["moon.mod", "moon.pkg"],
      signatures=[
        signature("///|", 3),
        signature("pub predicate ", 3),
        signature("fn main {", 2),
        signature("derive(Debug)", 2),
        signature("proof_ensure", 2),
        signature("pub fn ", 1),
      ],
      keywords="as async break catch const continue derive else enum extern fn for guard if impl import in init let loop match mut predicate proof_assert proof_decrease proof_ensure proof_external proof_import proof_invariant proof_pure proof_reasoning proof_require proof_yield pub raise return struct test throw trait try type while with",
      types="Array Bool Byte Bytes Char Double Error FixedArray Int Int64 Map Option Result String StringBuilder UInt UInt64 Unit",
      constants="true false None Some Ok Err",
      declarations=[
        ("fn", FunctionSymbol),
        ("predicate", FunctionSymbol),
        ("struct", TypeSymbol),
        ("enum", TypeSymbol),
        ("trait", TypeSymbol),
        ("type", TypeSymbol),
        ("let", VariableSymbol),
      ],
      line_comments=["//"],
      block_comments=c_blocks(),
      strings=moonbit_strings(),
      operator_chars="+-*/%=<>!&|^~?.",
      identifier_extra="$",
    ),
    make_language(
      id="vibe",
      name="Vibe",
      aliases=["vibe-lang", "vpkg"],
      extensions=["vibe", "vibex", "vpkg"],
      filenames=[],
      signatures=[
        signature("ArrayBuilder::", 3),
        signature("with Exception[", 3),
        signature("with Console", 3),
        signature("handle {", 2),
        signature("let rec ", 2),
      ],
      keywords="as async await bench break catch class const continue effect else enum export extern fn for from handle if import in interface let loop match module mut of rec return struct throw trait try type while with",
      types="Array ArrayBuilder Async Bool Byte Bytes Char Console Double Effect Error Exception Float Fs Int Map Option Result Send Set String TaskGroup UInt Unit",
      constants="true false None Some Ok Err Throw",
      declarations=[
        ("fn", FunctionSymbol),
        ("class", TypeSymbol),
        ("enum", TypeSymbol),
        ("interface", TypeSymbol),
        ("let", VariableSymbol),
        ("module", ModuleSymbol),
        ("struct", TypeSymbol),
        ("trait", TypeSymbol),
        ("type", TypeSymbol),
      ],
      line_comments=["//"],
      block_comments=c_blocks(),
      strings=c_strings(),
      operator_chars="+-*/%=<>!&|^~?.",
      identifier_extra="$",
      functions="print println stdout_write stdout_writeln",
    ),
    make_language(
      id="veryl",
      name="Veryl",
      aliases=[],
      extensions=["veryl"],
      filenames=[],
      signatures=[
        signature("always_ff", 4),
        signature("if_reset", 4),
        signature("logic<", 3),
        signature("modport ", 3),
        signature("input  clock", 3),
        signature("package ", 1),
        signature("assign ", 1),
      ],
      keywords="alias always_comb always_ff assign as bind block break case connect const converse default else embed enum final for function gen if if_reset import include initial in inout input inside inst interface let mixin modport module output outside package param proto pub repeat return rev same step struct switch type union unsafe var",
      types="bbool bit clock clock_negedge clock_posedge f32 f64 i8 i16 i32 i64 lbool logic p8 p16 p32 p64 reset reset_async_high reset_async_low reset_sync_high reset_sync_low signed string tri u8 u16 u32 u64",
      constants="false lsb msb true",
      declarations=[
        ("alias", TypeSymbol),
        ("const", VariableSymbol),
        ("enum", TypeSymbol),
        ("function", FunctionSymbol),
        ("inst", VariableSymbol),
        ("interface", TypeSymbol),
        ("let", VariableSymbol),
        ("modport", PropertySymbol),
        ("module", TypeSymbol),
        ("package", ModuleSymbol),
        ("param", VariableSymbol),
        ("proto", TypeSymbol),
        ("struct", TypeSymbol),
        ("type", TypeSymbol),
        ("union", TypeSymbol),
        ("var", VariableSymbol),
      ],
      line_comments=["///", "//"],
      block_comments=c_blocks(),
      strings=[delimiter("sv{{{", "}}}"), quoted("\"")],
      operator_chars="+-*/%=<>!&|^~?.:#@",
      identifier_extra="$",
    ),
    make_language(
      id="tnix",
      name="tNix",
      aliases=["typed-nix"],
      extensions=["tnix"],
      filenames=["tnix.config.tnix"],
      signatures=[
        signature("forall ", 2),
        signature(" :: ", 2),
        signature("declare \"", 3),
        signature("# @tnix-", 2),
      ],
      keywords="as assert declare else extends forall if import in infer inherit let or rec satisfies then type with",
      types="Any Bool Derivation Float Functor Int List Matrix Nat Number Path Range String Tensor Tuple Unit Vec any dynamic unknown",
      constants="true false null",
      declarations=[("let", VariableSymbol), ("type", TypeSymbol)],
      line_comments=["#"],
      block_comments=c_blocks(),
      strings=[quoted("''"), quoted("\"")],
      operator_chars="+-*/=<>!&|^~?.:$@",
      identifier_extra="$",
    ),
    make_language(
      id="mbtv",
      name="Vapor Moon SFC",
      aliases=["vapor-moon", "moonbit-vue"],
      extensions=["mbtv"],
      filenames=[],
      signatures=[
        signature("<script extern>", 3),
        signature("<template>", 3),
        signature("defineProps()", 3),
        signature("v-model", 2),
        signature("<script>", 2),
        signature("{{ ", 2),
      ],
      keywords="as async break catch component const continue derive else enum extern fn for guard if impl import in init let loop match mut pub raise return script setup struct style template test throw trait try type while with",
      types="Array Bool Byte Bytes Char Double Error FixedArray Int Int64 Map Option Result String StringBuilder UInt UInt64 Unit",
      constants="true false None Some Ok Err",
      declarations=[
        ("fn", FunctionSymbol),
        ("struct", TypeSymbol),
        ("enum", TypeSymbol),
        ("trait", TypeSymbol),
        ("type", TypeSymbol),
        ("let", VariableSymbol),
      ],
      line_comments=["//"],
      block_comments=c_blocks(),
      strings=moonbit_strings(),
      operator_chars="+-*/%=<>!&|^~?.@#",
      identifier_extra="$-",
      functions="computed defineEmits defineExpose defineProps defineSlots inject provide signal use_id use_template_ref watch",
      properties="class is lang scoped v-bind v-for v-if v-model v-on v-show",
